# ── AI-Kiosk Backend Environment Variables ──
# Copy this to .env and fill in real values

APP_NAME=AI-Kiosk Backend
APP_VERSION=0.1.0
DEBUG=true

# Set to false to use real Whisper, RAG, Ollama, Edge-TTS
USE_MOCK_SERVICES=false

# Whisper ASR
WHISPER_MODEL_SIZE=base

# SQLite
SQLITE_DB_PATH=./data/kiosk.db

# PostgreSQL (pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vidyasahayak

# Session TTL
SESSION_TTL_SECONDS=1800

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Optional Upstash Redis & Cloud Web App (for remote phone navigation over 4G/5G)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
# PUBLIC_WEB_APP_URL=https://...

# CORS – comma separated origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Facial Recognition Threshold
FACE_MATCH_THRESHOLD=0.35

# Gemini API Configuration (comma-separated keys for pool rotation)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEYS="your_gemini_api_key_1,your_gemini_api_key_2"

# PESU Academy Credentials (for automated announcement scraping)
PESU_ACADEMY_USERNAME=your_pesu_srn
PESU_ACADEMY_PASSWORD=your_pesu_password
